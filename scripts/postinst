#!/bin/bash
set -e
# Core script , this is the script that runs after the installation of the .deb package.
# And it point to the devpanel-setup.sh 
# Do not change the file or overwrite it , unless you know what you are doing.
SETUP_SCRIPT="/usr/share/devpanel/devpanel-setup.sh"

if [ ! -f "$SETUP_SCRIPT" ]; then
    echo "DevPanel: setup script not found at $SETUP_SCRIPT — skipping."
    echo "          Run manually: sudo bash $SETUP_SCRIPT"
    exit 0
fi

if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
    TARGET_USER="$SUDO_USER"
elif [ -n "$PKEXEC_UID" ]; then
    TARGET_USER=$(getent passwd "$PKEXEC_UID" | cut -d: -f1)
else
    TARGET_USER=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 && $7 !~ /nologin|false/ {print $1; exit}')
fi

if [ -z "$TARGET_USER" ]; then
    echo "DevPanel: could not determine target user — skipping auto-setup."
    echo "          Run manually: sudo bash $SETUP_SCRIPT"
    exit 0
fi

echo "DevPanel: running setup for user: $TARGET_USER"

SUDO_USER="$TARGET_USER" bash "$SETUP_SCRIPT"

exit 0
