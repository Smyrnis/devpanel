#!/bin/bash
set -e

# DevPanel post-install script
# Deploys the welcome index.php to /var/www/html if it's the default Apache page

# Source directory where index.php is installed
SOURCE_FILE="/usr/share/devpanel/index.php"
DEST_DIR="/var/www/html"
DEST_FILE="$DEST_DIR/index.php"
BACKUP_FILE="$DEST_DIR/index.php.backup"

# Create destination directory if it doesn't exist
if [ ! -d "$DEST_DIR" ]; then
    mkdir -p "$DEST_DIR"
    chown www-data:www-data "$DEST_DIR"
    chmod 755 "$DEST_DIR"
fi

# Check if source file exists
if [ -f "$SOURCE_FILE" ]; then
    # Backup existing index.php if it exists and is default Apache page
    if [ -f "$DEST_FILE" ]; then
        # Check if it's the default Apache index page
        if grep -q "Apache" "$DEST_FILE" 2>/dev/null || grep -q "It works" "$DEST_FILE" 2>/dev/null || [ ! -s "$DEST_FILE" ]; then
            cp "$DEST_FILE" "$BACKUP_FILE"
            echo "Backed up existing index.php to $BACKUP_FILE"
        else
            # User has custom index.php, don't overwrite
            echo "Custom index.php detected, skipping deployment"
            exit 0
        fi
    fi

    # Deploy the new index.php
    cp "$SOURCE_FILE" "$DEST_FILE"
    chown www-data:www-data "$DEST_FILE"
    chmod 644 "$DEST_FILE"
    echo "DevPanel index.php deployed to $DEST_FILE"
else
    echo "Warning: Source file $SOURCE_FILE not found"
    exit 1
fi

exit 0
